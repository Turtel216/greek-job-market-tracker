# Copy this file to .env and fill in real values. Never commit .env.
# Every variable the stack reads is listed here with a placeholder.

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
WAREHOUSE_DB=warehouse

# Database role passwords (see infra/postgres/init)
LOADER_PASSWORD=change-me
TRANSFORMER_PASSWORD=change-me
BI_READER_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
METABASE_DB_PASSWORD=change-me

# Object store (any S3-compatible server)
S3_ENDPOINT_URL=http://objectstore:3900
# Must match s3_region in infra/objectstore/garage.toml
S3_REGION=garage
# Garage needs keys in a fixed format. Generate with:
#   key id: echo "GK$(openssl rand -hex 12)"
#   secret: openssl rand -hex 32
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_RAW=jobtracker-raw

# Garage server secrets
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
# Generate with: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=change-me

# Airflow
AIRFLOW_ADMIN_PASSWORD=change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=change-me
ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/change-me
ALERT_EMAIL=alerts@example.org

# dbt
DBT_TARGET=dev
DBT_THREADS=4

# Scraping
SCRAPER_CONTACT_EMAIL=maintainer@example.org
SCRAPER_USER_AGENT_VERSION=0.1.0

# Public
DASHBOARD_HOSTNAME=jobs.example.org

# Backups
BACKUP_DIR=./backups
