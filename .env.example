# Copy this file to .env and fill in real values. Never commit .env.
# Every variable the stack reads is listed here with a placeholder.

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
WAREHOUSE_DB=warehouse

# Database role passwords (see infra/postgres/init)
LOADER_PASSWORD=change-me
TRANSFORMER_PASSWORD=change-me
# Also goes into the Airflow connection URL for the daily summary, so use
# only URL safe characters. Generate with: openssl rand -hex 24
BI_READER_PASSWORD=change-me
# Goes into the Airflow database URL, so use only URL safe characters.
# Generate with: openssl rand -hex 24
AIRFLOW_DB_PASSWORD=change-me
METABASE_DB_PASSWORD=change-me

# Object store (any S3-compatible server)
S3_ENDPOINT_URL=http://objectstore:3900
# Must match s3_region in infra/objectstore/garage.toml
S3_REGION=garage
# Garage needs keys in a fixed format. Generate with:
#   key id: echo "GK$(openssl rand -hex 12)"
#   secret: openssl rand -hex 32
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_RAW=jobtracker-raw

# Garage server secrets
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
# Generate with: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=change-me

# Airflow
AIRFLOW_ADMIN_PASSWORD=change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=change-me
# Shared by every Airflow service to sign task tokens.
# Generate with: openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=change-me

# Alerts go to Discord. Email is the fallback, sent through the
# AIRFLOW_CONN_SMTP_DEFAULT connection. Leave a value empty to turn it off.
ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/change-me
ALERT_EMAIL=alerts@example.org
AIRFLOW_CONN_SMTP_DEFAULT=smtp://user:change-me@smtp.example.org:587?from_email=alerts%40example.org

# dbt
DBT_TARGET=dev
DBT_THREADS=4

# Scraping. These make up the User-Agent sent to every source.
SCRAPER_CONTACT_EMAIL=maintainer@example.org
SCRAPER_REPO_URL=https://github.com/change-me/job-market-tracker
SCRAPER_USER_AGENT_VERSION=0.1.0
# Path to the source registry. Only needed when the ingestion package is
# installed outside the repo, for example in the Airflow image.
JOBTRACKER_SOURCES=./config/sources.yml

# Metabase. metabase-init creates this admin on the first start. The
# password needs at least 6 characters and a digit.
METABASE_ADMIN_EMAIL=admin@example.org
METABASE_ADMIN_PASSWORD=change-me-1
# Encrypts the warehouse password Metabase keeps in its database. Changing
# it later locks Metabase out of that password.
# Generate with: openssl rand -base64 32
METABASE_ENCRYPTION_SECRET_KEY=change-me
# Public links are built from this: http://localhost:3000 locally, and
# https:// plus DASHBOARD_HOSTNAME on the server
METABASE_SITE_URL=http://localhost:3000

# Public
DASHBOARD_HOSTNAME=jobs.example.org

# Backups
BACKUP_DIR=./backups
